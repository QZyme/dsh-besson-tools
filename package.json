{
  "name": "dsh-besson-tools",
  "version": "2.3.0",
  "description": "北山 Besson 模组开发助手：9 个工具检索 217 篇教程、规划学习路线、对比版本、环境搭建、工程体检与迁移清单；附左栏入口面板（DSH 0.2.2-rc.1+ bundle）。",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./lookup": "./lib/tools/lookup.mjs",
    "./index": "./lib/tools/index.mjs",
    "./series": "./lib/tools/series.mjs",
    "./fetch": "./lib/tools/fetch.mjs",
    "./plan": "./lib/tools/plan.mjs",
    "./compare": "./lib/tools/compare.mjs",
    "./env": "./lib/tools/env.mjs",
    "./mod-project": "./lib/tools/mod_project.mjs",
    "./mod-migrate": "./lib/tools/mod_migrate.mjs"
  },
  "files": [
    "besson-tools.mjs",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "minecraft",
    "modding",
    "tutorials",
    "besson"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QZyme/dsh-besson-tools.git"
  },
  "homepage": "https://github.com/QZyme/dsh-besson-tools#readme",
  "bugs": {
    "url": "https://github.com/QZyme/dsh-besson-tools/issues"
  },
  "author": "QZyme"
}
