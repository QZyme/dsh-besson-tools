{
  "name": "dsh-besson-tools",
  "version": "2.4.6",
  "description": "北山Besson 模组开发助手（DSH 0.2.2-rc.3+ bundle 形态）：11 个工具检索 217 篇教程文章、规划学习路线、对比版本环境差异、抓取文章正文、工程体检、迁移清单、骨架生成与中文映射；Web 左栏面板含实时数据与工具调用统计（数据同步 2026-11-07）。",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./lookup": "./lib/tools/lookup.mjs",
    "./index": "./lib/tools/index.mjs",
    "./series": "./lib/tools/series.mjs",
    "./fetch": "./lib/tools/fetch.mjs",
    "./plan": "./lib/tools/plan.mjs",
    "./compare": "./lib/tools/compare.mjs",
    "./env": "./lib/tools/env.mjs",
    "./mod-project": "./lib/tools/mod_project.mjs",
    "./mod-migrate": "./lib/tools/mod_migrate.mjs",
    "./mod-scaffold": "./lib/tools/mod_scaffold.mjs",
    "./mod-mapping": "./lib/tools/mod_mapping.mjs"
  },
  "files": [
    "besson-tools.mjs",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "minecraft",
    "modding",
    "tutorials",
    "besson"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QZyme/dsh-besson-tools.git"
  },
  "homepage": "https://github.com/QZyme/dsh-besson-tools#readme",
  "bugs": {
    "url": "https://github.com/QZyme/dsh-besson-tools/issues"
  },
  "author": "QZyme"
}
